  var chairs = [];
  var radius = -1;
  var chairTicking = false;

  function ringRadius(){ return window.innerWidth < 760 ? -238 : -274; }

  function paintChair(c){
    var lift = c.pull * 92;
    c.el.style.transform =
      'rotate(' + c.a + 'deg) translateY(' + (radius - lift) + 'px) scale(' + (1 + c.pull * 0.08) + ')';
  }
  function chairTick(){
    var moving = false;
    for (var i = 0; i < chairs.length; i++){
      var c = chairs[i];
      var d = c.target - c.pull;
      if (Math.abs(d) > 0.0015){ c.pull += d * 0.2; moving = true; }
      else if (c.pull !== c.target){ c.pull = c.target; }
      paintChair(c);
    }
    if (moving) window.requestAnimationFrame(chairTick);
    else chairTicking = false;
  }
  function startChairs(){
    if (!chairTicking){ chairTicking = true; window.requestAnimationFrame(chairTick); }
  }

  MENU.forEach(function(item, i){
    var angle = (360 / MENU.length) * i;
    var el = document.createElement('button');
    el.type = 'button';
    el.className = 'chair';
    el.style.setProperty('--a', angle + 'deg');
    el.setAttribute('role', 'listitem');
    el.setAttribute('aria-label', item.name + '. ' + item.short);
    el.innerHTML =
      '<span class="chair-back"></span><span class="chair-seat"></span>' +
      '<span class="chair-tag">' + pad(i + 1) + '</span>' +
      '<span class="chair-label"><span class="chair-num">' + pad(i + 1) + '</span>' + item.name + '</span>';

    var c = { el: el, a: angle, pull: 0, target: 0 };

    function serve(){
      chairs.forEach(function(o){ o.target = 0; o.el.classList.remove('active'); });
      c.target = 1;
      el.classList.add('active');
      startChairs();
      plate.classList.add('filled');
      plateIcon.innerHTML = ICON[item.icon];
      plateKicker.textContent = 'No. ' + pad(i + 1) + ' on the menu';
      plateTitle.textContent = item.name;
      plateText.textContent = item.short;
      readoutKicker.textContent = 'No. ' + pad(i + 1) + ' on the menu';
      readoutTitle.textContent = item.name;
      readoutText.textContent = item.short;
    }
    function unserve(){ c.target = 0; el.classList.remove('active'); startChairs(); }

    el.addEventListener('mouseenter', serve);
    el.addEventListener('mouseleave', unserve);
    el.addEventListener('focus', serve);
    el.addEventListener('blur', unserve);
    el.addEventListener('click', function(e){ e.preventDefault(); serve(); });

    seats.appendChild(el);
    chairs.push(c);
  });

  function layoutChairs(){
    var r = ringRadius();
    if (r === radius) return;
    radius = r;
    chairs.forEach(paintChair);
  }

  /* ============================================================
     THE CAMERA
     ============================================================ */
  var world = document.getElementById('world');
  var rig = document.getElementById('rig');
  var stage = world.querySelector('.stage');
  var nav = document.getElementById('nav');
  var calm = window.matchMedia('(prefers-reduced-motion: reduce)');

  var END = 0.72;
  var TILT = -78;
  var target = 0, current = 0, ticking = false, inView = true;
  var wsShop = 1, wsTable = 1, baseY = 0;

  function clamp(v, a, b){ return v < a ? a : (v > b ? b : v); }
  function smooth(t){ return t * t * (3 - 2 * t); }

  function readScroll(){
    var box = world.getBoundingClientRect();
    var span = world.offsetHeight - window.innerHeight;
    target = span > 0 ? clamp(-box.top / span, 0, 1) : 0;
  }
  function sizeStage(){
    var vw = window.innerWidth, vh = window.innerHeight;
    var narrow = vw < 760;
    wsShop = clamp(Math.min(vw / 1440, vh / 900), narrow ? 0.62 : 0.52, 1.1);
    baseY = narrow ? 104 : 0;
    wsTable = clamp(Math.min(vw / (narrow ? 660 : 1040), vh / (narrow ? 830 : 900)), 0.30, 1.15);
    layoutChairs();
  }

  function draw(){
    var cp = smooth(clamp(current / END, 0, 1));
    rig.style.setProperty('--ws', (wsShop + (wsTable - wsShop) * cp).toFixed(3));
    rig.style.setProperty('--camrx', (TILT * cp).toFixed(2) + 'deg');
    rig.style.setProperty('--camy', (baseY * (1 - cp) + 34 * cp).toFixed(1) + 'px');
    rig.style.setProperty('--camz', (34 * cp).toFixed(1) + 'px');

    stage.style.setProperty('--heroFade', clamp(1 - cp / 0.30, 0, 1).toFixed(3));
    stage.style.setProperty('--shopFade', clamp(1 - (cp - 0.34) / 0.30, 0, 1).toFixed(3));
    stage.style.setProperty('--tableFade', clamp((cp - 0.40) / 0.32, 0, 1).toFixed(3));

    stage.classList.toggle('past-hero', cp > 0.26);
    seats.classList.toggle('live', cp > 0.5);
    nav.classList.toggle('show', current > 0.06);
  }

  function loop(){
    ticking = false;
    if (calm.matches) current = target;
    else {
      current += (target - current) * 0.16;
      if (Math.abs(target - current) < 0.0006) current = target;
    }
    draw();
    if (Math.abs(target - current) > 0.0006 && inView) request();
  }
  function request(){ if (!ticking){ ticking = true; window.requestAnimationFrame(loop); } }
  function onScroll(){ readScroll(); request(); }

  if ('IntersectionObserver' in window){
    new IntersectionObserver(function(e){
      inView = e[0].isIntersecting;
      if (inView) request();
    }, { rootMargin: '10px' }).observe(world);
  }

  sizeStage();
  readScroll();
  current = target;
  draw();
  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', function(){ sizeStage(); readScroll(); request(); });

  /* ---------- odds and ends ---------- */
  document.getElementById('yr').textContent = new Date().getFullYear();
  document.getElementById('orderForm').addEventListener('submit', function(e){
    e.preventDefault();
    if (!this.checkValidity()){ this.reportValidity(); return; }
    document.getElementById('confirmMsg').classList.add('show');
    this.reset();
  });
})();
</script>


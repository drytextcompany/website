<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>The Dry Text Co. — Content that's cooked to order</title>
<meta name="description" content="The Dry Text Co. is a content writing agency serving up copywriting, ghostwriting, website content, ad scripts, social media, newsletters and SEO content.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;0,9..144,700;0,9..144,900;1,9..144,500;1,9..144,600&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#221D18;
    --paper:#FAF0DE;
    --mustard:#EFA435;
    --coral:#E1503A;
    --teal:#1C6C63;
    --cream-soft:#FFF8EC;
    --ink-70: rgba(34,29,24,0.7);
    --paper-70: rgba(250,240,222,0.7);
    --radius: 6px;
    --max-w: 1120px;
  }

  *{ box-sizing:border-box; }
  html{ scroll-behavior:smooth; }
  body{
    margin:0;
    background:var(--paper);
    color:var(--ink);
    font-family:'Space Grotesk', sans-serif;
    line-height:1.5;
    -webkit-font-smoothing:antialiased;
  }
  h1,h2,h3{
    font-family:'Fraunces', serif;
    margin:0;
    line-height:1.05;
  }
  p{ margin:0; }
  a{ color:inherit; }
  img,svg{ display:block; max-width:100%; }
  .wrap{
    max-width:var(--max-w);
    margin:0 auto;
    padding:0 28px;
  }
  ::selection{ background:var(--coral); color:var(--cream-soft); }

  a:focus-visible, button:focus-visible, input:focus-visible, textarea:focus-visible, select:focus-visible{
    outline:3px solid var(--teal);
    outline-offset:3px;
  }

  @media (prefers-reduced-motion: reduce){
    *{ animation-duration:0.001ms !important; animation-iteration-count:1 !important; transition-duration:0.001ms !important; scroll-behavior:auto !important; }
  }

  /* ---------- NAV ---------- */
  .nav{
    position:sticky; top:0; z-index:50;
    background:var(--ink);
    border-bottom:1px solid rgba(255,255,255,0.08);
  }
  .nav .wrap{
    display:flex; align-items:center; justify-content:space-between;
    padding-top:16px; padding-bottom:16px;
  }
  .nav-mark{
    font-family:'Fraunces', serif;
    font-weight:700;
    font-size:1.25rem;
    color:var(--cream-soft);
    letter-spacing:-0.01em;
  }
  .nav-links{
    display:flex; gap:28px; list-style:none; margin:0; padding:0;
  }
  .nav-links a{
    color:var(--paper-70);
    text-decoration:none;
    font-size:0.95rem;
  }
  .nav-links a:hover{ color:var(--mustard); }
  .nav-cta{
    background:var(--coral);
    color:var(--cream-soft);
    padding:9px 18px;
    border-radius:var(--radius);
    text-decoration:none;
    font-size:0.9rem;
    font-weight:600;
  }
  .nav-cta:hover{ background:#c9432f; }
  @media (max-width: 720px){
    .nav-links{ display:none; }
  }

  /* ---------- HERO ---------- */
  .hero{
    background:var(--ink);
    color:var(--cream-soft);
    position:relative;
    overflow:hidden;
    padding:96px 0 0;
  }
  .hero .wrap{
    text-align:center;
    display:flex; flex-direction:column; align-items:center;
  }
  .sign{
    display:inline-block;
    background:var(--mustard);
    color:var(--ink);
    padding:10px 26px;
    border-radius:4px;
    transform-origin:top center;
    animation: dropIn 900ms cubic-bezier(.2,1.5,.4,1) both;
  }
  .sign span{
    font-family:'Space Grotesk', sans-serif;
    font-weight:600;
    font-size:0.8rem;
    letter-spacing:0.02em;
  }
  .hero h1{
    margin-top:28px;
    font-size:clamp(2.6rem, 7vw, 5rem);
    font-weight:700;
    opacity:0;
    animation: fadeUp 700ms ease-out 500ms both;
  }
  .hero .tagline{
    margin-top:18px;
    font-family:'Fraunces', serif;
    font-style:italic;
    font-weight:500;
    color:var(--coral);
    font-size:clamp(1.05rem, 2.4vw, 1.4rem);
    opacity:0;
    animation: fadeUp 700ms ease-out 800ms both;
  }
  .hero .sub{
    margin-top:16px;
    max-width:560px;
    color:var(--paper-70);
    font-size:1.05rem;
    opacity:0;
    animation: fadeUp 700ms ease-out 1000ms both;
  }
  .hero .cta-row{
    margin-top:34px;
    display:flex;
    gap:14px;
    flex-wrap:wrap;
    justify-content:center;
    opacity:0;
    animation: fadeUp 700ms ease-out 1200ms both;
  }
  .btn{
    display:inline-block;
    padding:14px 26px;
    border-radius:var(--radius);
    text-decoration:none;
    font-weight:600;
    font-size:0.98rem;
    border:2px solid transparent;
    cursor:pointer;
    font-family:'Space Grotesk', sans-serif;
  }
  .btn-primary{
    background:var(--coral);
    color:var(--cream-soft);
  }
  .btn-primary:hover{ background:#c9432f; }
  .btn-ghost{
    background:transparent;
    color:var(--cream-soft);
    border-color:rgba(255,255,255,0.35);
  }
  .btn-ghost:hover{ border-color:var(--mustard); color:var(--mustard); }

  @keyframes dropIn{
    0%{ transform:translateY(-140%) rotate(-8deg); opacity:0; }
    60%{ transform:translateY(6%) rotate(2deg); opacity:1; }
    100%{ transform:translateY(0) rotate(0deg); opacity:1; }
  }
  @keyframes fadeUp{
    from{ opacity:0; transform:translateY(14px); }
    to{ opacity:1; transform:translateY(0); }
  }

  /* Ticker */
  .ticker-band{
    margin-top:56px;
    background:var(--mustard);
    color:var(--ink);
    overflow:hidden;
    border-top:1px solid rgba(0,0,0,0.15);
    border-bottom:1px solid rgba(0,0,0,0.15);
  }
  .ticker-track{
    display:flex;
    width:max-content;
    animation: scroll 28s linear infinite;
  }
  .ticker-track span{
    padding:12px 34px;
    font-weight:600;
    font-size:0.95rem;
    white-space:nowrap;
    border-right:1px solid rgba(0,0,0,0.18);
  }
  @keyframes scroll{
    from{ transform:translateX(0); }
    to{ transform:translateX(-50%); }
  }

  /* Counter divider (brick ledge, echoes the reference photo) */
  .counter-divider{
    height:34px;
    background:
      linear-gradient(var(--paper), var(--paper)) ,
      repeating-linear-gradient(90deg, #B5652E 0 46px, #9c5527 46px 48px);
    background-size:100% 100%, 100% 100%;
    position:relative;
  }
  .counter-divider::before{
    content:"";
    position:absolute; inset:0;
    background:repeating-linear-gradient(0deg, transparent 0 15px, rgba(0,0,0,0.12) 15px 17px);
  }

  /* ---------- SECTION HEADERS ---------- */
  section{ padding:88px 0; }
  .section-head{
    max-width:640px;
    margin:0 auto 52px;
    text-align:center;
  }
  .section-head h2{
    font-size:clamp(2rem, 4.5vw, 2.8rem);
    font-weight:600;
    font-style:italic;
  }
  .section-head p{
    margin-top:14px;
    color:var(--ink-70);
    font-size:1.05rem;
  }

  /* ---------- MENU / SERVICES ---------- */
  .menu-section{ background:var(--paper); }
  .menu-grid{
    display:grid;
    grid-template-columns:repeat(3, 1fr);
    gap:2px;
    background:rgba(34,29,24,0.15);
    border:1px solid rgba(34,29,24,0.15);
    border-radius:var(--radius);
    overflow:hidden;
  }
  .menu-item{
    background:var(--cream-soft);
    padding:30px 26px;
    display:flex;
    flex-direction:column;
    gap:10px;
    transition:background 160ms ease;
  }
  .menu-item:hover{ background:#fff; }
  .menu-item .fork{
    width:22px; height:22px;
    color:var(--coral);
    flex-shrink:0;
  }
  .menu-item h3{
    font-size:1.15rem;
    font-weight:600;
    font-style:italic;
  }
  .menu-item p{
    color:var(--ink-70);
    font-size:0.95rem;
  }
  @media (max-width:880px){
    .menu-grid{ grid-template-columns:repeat(2, 1fr); }
  }
  @media (max-width:560px){
    .menu-grid{ grid-template-columns:1fr; }
  }

  /* ---------- ABOUT ---------- */
  .about-section{
    background:var(--teal);
    color:var(--cream-soft);
  }
  .about-grid{
    display:grid;
    grid-template-columns:1fr 1.15fr;
    gap:60px;
    align-items:center;
  }
  .about-grid .plate{
    justify-self:center;
    width:min(320px, 80%);
  }
  .about-copy h2{
    font-size:clamp(1.9rem, 4vw, 2.5rem);
    font-weight:600;
    font-style:italic;
    color:var(--mustard);
  }
  .about-copy p{
    margin-top:20px;
    font-size:1.05rem;
    color:rgba(255,248,236,0.88);
    max-width:520px;
  }
  .about-copy p + p{ margin-top:14px; }
  @media (max-width:820px){
    .about-grid{ grid-template-columns:1fr; text-align:center; }
    .about-copy p{ margin-left:auto; margin-right:auto; }
  }

  /* ---------- CONTACT ---------- */
  .contact-section{ background:var(--ink); color:var(--cream-soft); }
  .contact-box{
    max-width:640px;
    margin:0 auto;
    background:var(--cream-soft);
    color:var(--ink);
    border-radius:10px;
    padding:44px;
  }
  .contact-box h2{
    font-size:clamp(1.8rem, 4vw, 2.3rem);
    font-weight:600;
    font-style:italic;
    text-align:center;
  }
  .contact-box .sub{
    text-align:center;
    margin-top:10px;
    color:var(--ink-70);
  }
  form{ margin-top:30px; display:flex; flex-direction:column; gap:18px; }
  .field{ display:flex; flex-direction:column; gap:6px; }
  label{ font-size:0.9rem; font-weight:600; }
  input, textarea, select{
    font-family:'Space Grotesk', sans-serif;
    font-size:1rem;
    padding:12px 14px;
    border-radius:6px;
    border:1.5px solid rgba(34,29,24,0.25);
    background:var(--paper);
    color:var(--ink);
  }
  textarea{ resize:vertical; min-height:110px; }
  .submit-btn{
    margin-top:6px;
    background:var(--coral);
    color:var(--cream-soft);
    border:none;
    padding:15px 20px;
    border-radius:6px;
    font-weight:700;
    font-size:1rem;
    cursor:pointer;
  }
  .submit-btn:hover{ background:#c9432f; }
  .form-note{
    margin-top:14px;
    font-size:0.85rem;
    color:var(--ink-70);
    text-align:center;
  }
  .confirm{
    display:none;
    margin-top:18px;
    padding:14px 16px;
    background:rgba(28,108,99,0.12);
    border:1px solid var(--teal);
    border-radius:6px;
    color:var(--teal);
    font-weight:600;
    text-align:center;
  }
  .confirm.show{ display:block; }

  /* ---------- FOOTER ---------- */
  footer{
    background:var(--ink);
    color:var(--paper-70);
    padding:40px 0 32px;
    border-top:1px solid rgba(255,255,255,0.08);
  }
  footer .wrap{
    display:flex; flex-wrap:wrap; gap:16px;
    align-items:center; justify-content:space-between;
  }
  footer .tag{
    font-family:'Fraunces', serif;
    font-style:italic;
    color:var(--mustard);
    font-size:1rem;
  }
  footer .email{ font-size:0.92rem; text-decoration:none; }
  footer .email:hover{ color:var(--mustard); }
</style>
</head>
<body>

  <nav class="nav">
    <div class="wrap">
      <div class="nav-mark">The Dry Text Co.</div>
      <ul class="nav-links">
        <li><a href="#menu">Menu</a></li>
        <li><a href="#about">About</a></li>
        <li><a href="#contact">Contact</a></li>
      </ul>
      <a href="#contact" class="nav-cta">Place an order</a>
    </div>
  </nav>

  <header class="hero">
    <div class="wrap">
      <div class="sign"><span>EST. AHMEDABAD</span></div>
      <h1>The Dry Text&nbsp;Co.</h1>
      <p class="tagline">Don't go by the name — cuz we're cheesy.</p>
      <p class="sub">A content writing agency that cooks up words for websites, ads, socials and everything in between. Order up.</p>
      <div class="cta-row">
        <a href="#contact" class="btn btn-primary">Place an order</a>
        <a href="#menu" class="btn btn-ghost">See the menu</a>
      </div>
    </div>

    <div class="ticker-band" aria-hidden="true">
      <div class="ticker-track">
        <span>Copywriting</span><span>Ghostwriting</span><span>Website Content</span><span>Ad Scripts</span><span>Captions</span><span>Social Media Content</span><span>Newsletters</span><span>LinkedIn Posts</span><span>SEO Content</span>
        <span>Copywriting</span><span>Ghostwriting</span><span>Website Content</span><span>Ad Scripts</span><span>Captions</span><span>Social Media Content</span><span>Newsletters</span><span>LinkedIn Posts</span><span>SEO Content</span>
      </div>
    </div>
    <div class="counter-divider"></div>
  </header>

  <section class="menu-section" id="menu">
    <div class="wrap">
      <div class="section-head">
        <h2>What's on the menu today</h2>
        <p>Every dish is written fresh, to order. Nothing pulled off a shelf.</p>
      </div>

      <div class="menu-grid">

        <div class="menu-item">
          <svg class="fork" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6 2v8M9 2v8M6 6h3M7.5 10v12M15 2c-2 2-2 6 0 8s2 6 0 12M15 2v20"/></svg>
          <h3>Copywriting</h3>
          <p>Words that sell without sounding like a sales pitch.</p>
        </div>

        <div class="menu-item">
          <svg class="fork" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6 2v8M9 2v8M6 6h3M7.5 10v12M15 2c-2 2-2 6 0 8s2 6 0 12M15 2v20"/></svg>
          <h3>Ghostwriting</h3>
          <p>Your voice, sharpened — your name stays on it.</p>
        </div>

        <div class="menu-item">
          <svg class="fork" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6 2v8M9 2v8M6 6h3M7.5 10v12M15 2c-2 2-2 6 0 8s2 6 0 12M15 2v20"/></svg>
          <h3>Website Content</h3>
          <p>Copy that makes visitors stay and actually read.</p>
        </div>

        <div class="menu-item">
          <svg class="fork" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6 2v8M9 2v8M6 6h3M7.5 10v12M15 2c-2 2-2 6 0 8s2 6 0 12M15 2v20"/></svg>
          <h3>Ad Scripts</h3>
          <p>Lines built to stop the scroll, not blend into it.</p>
        </div>

        <div class="menu-item">
          <svg class="fork" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6 2v8M9 2v8M6 6h3M7.5 10v12M15 2c-2 2-2 6 0 8s2 6 0 12M15 2v20"/></svg>
          <h3>Captions</h3>
          <p>Short, sharp, and built to get shared.</p>
        </div>

        <div class="menu-item">
          <svg class="fork" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6 2v8M9 2v8M6 6h3M7.5 10v12M15 2c-2 2-2 6 0 8s2 6 0 12M15 2v20"/></svg>
          <h3>Social Media Content</h3>
          <p>Posts your audience actually stops for.</p>
        </div>

        <div class="menu-item">
          <svg class="fork" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6 2v8M9 2v8M6 6h3M7.5 10v12M15 2c-2 2-2 6 0 8s2 6 0 12M15 2v20"/></svg>
          <h3>Newsletters</h3>
          <p>Emails people open on purpose, not out of guilt.</p>
        </div>

        <div class="menu-item">
          <svg class="fork" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6 2v8M9 2v8M6 6h3M7.5 10v12M15 2c-2 2-2 6 0 8s2 6 0 12M15 2v20"/></svg>
          <h3>LinkedIn Posts</h3>
          <p>Professional, without putting anyone to sleep.</p>
        </div>

        <div class="menu-item">
          <svg class="fork" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6 2v8M9 2v8M6 6h3M7.5 10v12M15 2c-2 2-2 6 0 8s2 6 0 12M15 2v20"/></svg>
          <h3>SEO Content</h3>
          <p>Written for people first. Google follows along.</p>
        </div>

      </div>
    </div>
  </section>

  <section class="about-section" id="about">
    <div class="wrap about-grid">
      <svg class="plate" viewBox="0 0 200 200" fill="none">
        <ellipse cx="100" cy="120" rx="88" ry="30" fill="rgba(255,248,236,0.12)"/>
        <circle cx="100" cy="100" r="78" fill="var(--cream-soft)" opacity="0.95"/>
        <circle cx="100" cy="100" r="56" fill="none" stroke="var(--teal)" stroke-width="2" opacity="0.5"/>
        <path d="M70 90c6-14 20-18 30-10s26-4 30 10-8 30-30 30-36-16-30-30z" fill="var(--mustard)"/>
        <path d="M78 82c-2-10 2-18 2-18M92 78c0-10 2-18 2-18M106 80c2-10-2-18-2-18" stroke="var(--coral)" stroke-width="2.5" stroke-linecap="round"/>
      </svg>
      <div class="about-copy">
        <h2>Behind the counter</h2>
        <p>We're not part of your team, and we're not your everyday agency either. Think of us as an independent kitchen — we figure out exactly what you need, then get straight to cooking.</p>
        <p>No fixed desk, no filler hours. Just fast turnarounds and a straight answer, usually within a couple of hours.</p>
      </div>
    </div>
  </section>

  <section class="contact-section" id="contact">
    <div class="wrap">
      <div class="contact-box">
        <h2>Place an order</h2>
        <p class="sub">Tell us what you need. We'll get back to you fast.</p>

        <form id="orderForm">
          <div class="field">
            <label for="name">Your name</label>
            <input type="text" id="name" name="name" required>
          </div>
          <div class="field">
            <label for="email">Email address</label>
            <input type="email" id="email" name="email" required>
          </div>
          <div class="field">
            <label for="service">What do you need?</label>
            <select id="service" name="service">
              <option>Copywriting</option>
              <option>Ghostwriting</option>
              <option>Website Content</option>
              <option>Ad Scripts</option>
              <option>Captions</option>
              <option>Social Media Content</option>
              <option>Newsletters</option>
              <option>LinkedIn Posts</option>
              <option>SEO Content</option>
              <option>Not sure yet</option>
            </select>
          </div>
          <div class="field">
            <label for="message">Tell us a bit more</label>
            <textarea id="message" name="message" required></textarea>
          </div>
          <button type="submit" class="submit-btn">Send it over</button>
        </form>
        <div class="confirm" id="confirmMsg">Thanks! Your message is in. We'll get back to you soon.</div>
        <p class="form-note">We usually reply within a couple of hours.</p>
      </div>
    </div>
  </section>

  <footer>
    <div class="wrap">
      <div class="tag">The most creative content writing agency in Amdaaad ;)</div>
      <a class="email" href="mailto:info@thedrytextco.in">info@thedrytextco.in</a>
    </div>
  </footer>

  <script>
    // This currently just shows a confirmation message on the page.
    // In a later step, we'll connect this form to Resend so it actually
    // sends you a real email when someone submits it.
    document.getElementById('orderForm').addEventListener('submit', function(e){
      e.preventDefault();
      document.getElementById('confirmMsg').classList.add('show');
      this.reset();
    });
  </script>

</body>
</html>
